<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        O agente Java do OpenTelemetry injeta trace_id/span_id no MDC de cada
        requisição. Sobrescrevemos apenas o padrão do console (mantendo o
        restante do base.xml do Spring Boot) para que essa correlação também
        apareça nos logs locais, não só no Loki.
    -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} %-5level [trace_id=%X{trace_id:-},span_id=%X{span_id:-}] %logger{36} - %msg%n"/>

    <include resource="org/springframework/boot/logging/logback/base.xml"/>
</configuration>
