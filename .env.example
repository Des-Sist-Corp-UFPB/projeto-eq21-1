# =============================================================================
# Variáveis de ambiente — EXEMPLO
# =============================================================================
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores reais no .env
#   3. NUNCA faça commit do .env (ele está no .gitignore)
#
# No servidor de produção, este arquivo fica em:
#   /home/ghactions/mercado/.env
# A variável APP_IMAGE é atualizada automaticamente pelo GitHub Actions.
# =============================================================================

# Banco de dados
DB_USERNAME=eq21
DB_PASSWORD=troque-por-uma-senha-forte

# MinIO / S3
MINIO_ACCESS_KEY=eq21
MINIO_SECRET=troque-por-uma-chave-forte

# JWT
JWT_SECRET=troque-por-uma-chave-jwt-forte-com-pelo-menos-32-caracteres
JWT_EXPIRATION_MS=86400000

# Admin padrão (criado automaticamente na primeira subida)
ADMIN_EMAIL=troque-pelo-email-do-admin
ADMIN_SENHA=troque-por-uma-senha-forte

# Docker / Deploy (atualizado automaticamente pelo CI/CD a cada deploy)
# Substitua "usuario" pelo seu usuário ou organização no GitHub.
APP_IMAGE=ghcr.io/usuario/mercado:latest
