# =============================================================================
# Dockerfile de DESENVOLVIMENTO
# =============================================================================
# Objetivo: ambiente de desenvolvimento com hot-reload via Spring DevTools.
# O código-fonte é montado como volume — alterações em .java relançam a app.
#
# Como usar:
#   docker compose -f docker/docker-compose.dev.yml up
#
# ATENÇÃO: Esta imagem contém o JDK completo e ferramentas de build.
#          NUNCA use em produção.
# =============================================================================

FROM maven:3.9.9-eclipse-temurin-21 AS dev

WORKDIR /app

# Copiar apenas o pom.xml primeiro para aproveitar o cache de dependências.
# Se o pom.xml não mudar, o Docker reutiliza a camada de "mvn dependency:go-offline".
COPY pom.xml .
RUN mvn dependency:go-offline -B


# Agente Java do OpenTelemetry — instrumentação automática de traces, métricas
# e logs (Logback), sem alterar o código da aplicação.
ADD https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/latest/download/opentelemetry-javaagent.jar /otel-javaagent.jar

# O restante do código-fonte é montado via volume no docker-compose.
# Isso permite hot-reload sem reconstruir a imagem.

EXPOSE 8121

# -Dspring-boot.run.fork=false necessário para hot-reload funcionar dentro do container.
# Como fork=false roda a app na MESMA JVM do Maven, "-javaagent" via jvmArguments
# é ignorado — o agente OTel é anexado via variável de ambiente JAVA_TOOL_OPTIONS
# (definida no docker-compose.dev.yml), que o launcher "java" do Maven já respeita.
CMD ["mvn", "spring-boot:run", "-Dspring-boot.run.fork=false", "-Dspring-boot.run.jvmArguments=-Dspring.profiles.active=dev"]
